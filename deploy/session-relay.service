[Unit]
Description=Session Relay private conversation transfer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=session-relay
Group=session-relay
WorkingDirectory=/var/lib/session-relay
ExecStart=/opt/session-relay/relay server --listen 127.0.0.1:8787 --data /var/lib/session-relay
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/session-relay

[Install]
WantedBy=multi-user.target
